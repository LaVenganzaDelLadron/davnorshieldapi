# Application
APP_NAME=CyberShield DN API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIMEZONE=Asia/Manila

# JWT
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cybershield_dn
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cybershield_dn

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# AI Engine
AI_MIN_RISK_SCORE=50
AI_OUTBREAK_THRESHOLD=10
AI_SIMILARITY_THRESHOLD=60

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Manila
CYBER_WEATHER_CRON_HOUR=6
CYBER_WEATHER_CRON_MINUTE=0
OUTBREAK_INTERVAL_SECONDS=600
NOTIFICATION_INTERVAL_SECONDS=60
CLEANUP_CRON_HOUR=2
ANALYTICS_INTERVAL_SECONDS=3600

# Uploads
UPLOAD_DIR=uploads
REPORT_IMAGE_DIR=uploads/reports
MAX_UPLOAD_SIZE_MB=10
