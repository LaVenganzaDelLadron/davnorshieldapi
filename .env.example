# Application
APP_NAME=CyberShield DN API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=replace_me_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/cybershield_dn

# Firebase
FIREBASE_PROJECT_ID=cybershield-dn
FIREBASE_CREDENTIALS_PATH=credentials/firebase.json

# AI Engine
AI_PROVIDER=ollama
AI_MODEL=llama3.1
AI_API_KEY=
THREAT_SCORE_THRESHOLD=70

# Scheduler
OUTBREAK_INTERVAL_MINUTES=10
WEATHER_INTERVAL_HOURS=24
NOTIFICATION_INTERVAL_SECONDS=60

# Uploads
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
